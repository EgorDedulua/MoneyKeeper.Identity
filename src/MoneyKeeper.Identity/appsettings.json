{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System" : "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "JwtOptions": {
    "SecretKey": "",
    "Expires": "00:02:00"
  },
  "RefreshTokenOptions": {
    "Expires" :  "168:00:00"
  }
}
